rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow access to system configuration, announcements, and cooldown settings
    match /system/{docId} {
      allow read, write: if true;
    }

    // Cooldown tracking per IP/device/email
    match /cooldowns/{docId} {
      allow read, write: if true;
    }

    // Persistent activation and verification logs
    match /activations/{docId} {
      allow read, write: if true;
    }

    // Persistent VIP account keys managed by owner
    match /vip_accounts/{docId} {
      allow read, write: if true;
    }
  }
}
